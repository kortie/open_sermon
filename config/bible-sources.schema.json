{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bible-sources.json — bible reading and download link registry (DESIGN 3.15, CLAUDE.md rule 22)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "language", "rights", "read_url", "download_url", "verified_on", "note"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9_]{2,20}$" },
      "name": { "type": "string", "minLength": 1 },
      "language": { "enum": ["ko", "en"] },
      "rights": { "enum": ["public_domain", "copyrighted", "unverified"] },
      "read_url": { "type": "string", "pattern": "^(https://\\S+)?$" },
      "download_url": { "type": "string", "pattern": "^(https://\\S+)?$" },
      "verified_on": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
      "note": { "type": "string", "pattern": "^[a-z0-9_]*$" }
    }
  }
}
