# Copy to android/keystore.properties (not committed) to sign release builds with the Play upload key.
# Create the key once with:
#   keytool -genkeypair -v -keystore upload-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# Keep the .jks file and passwords outside the repository backups you share.
storeFile=upload-key.jks
storePassword=
keyAlias=upload
keyPassword=
